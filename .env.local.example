# Obtenha esses valores em: https://supabase.com/dashboard → seu projeto → Settings → API
#
# Estas variáveis SÃO seguras para o frontend — são chaves públicas (anon/publishable).
# A proteção dos dados está nas políticas RLS configuradas no banco de dados.
# NUNCA adicione a SERVICE_ROLE KEY em variáveis NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>

# ──────────────────────────────────────────────
# Painel de Administração (server-side apenas)
# ──────────────────────────────────────────────

# Service Role Key — NÃO use NEXT_PUBLIC_. Usada apenas em Server Components.
# Obtida em: Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=<sua-service-role-key>

# E-mail do administrador — quem pode acessar /admin
ADMIN_EMAIL=seu@email.com
