# Obtenha esses valores em: https://supabase.com/dashboard → seu projeto → Settings → API
#
# Estas variáveis SÃO seguras para o frontend — são chaves públicas (anon/publishable).
# A proteção dos dados está nas políticas RLS configuradas no banco de dados.
# NUNCA adicione a SERVICE_ROLE KEY aqui ou em variáveis NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>
